<.topnav current_user={@current_user} />

<%!-- Sidebar overlay (mobile) --%>
<div
  x-data="{ sidebarOpen: false }"
  @toggle-sidebar.window="sidebarOpen = !sidebarOpen"
  @keydown.escape.window="sidebarOpen = false"
>
  <%!-- Overlay --%>
  <div
    x-show="sidebarOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="sidebarOpen = false"
    class="fixed inset-0 bg-black/50 z-[140] lg:hidden"
    style="display: none; top: 64px;"
  ></div>

  <%!-- Sidebar --%>
  <aside
    class="fixed top-16 bottom-0 left-0 w-[260px] bg-[#0e0e0e] border-r border-[rgba(255,255,255,0.06)] flex flex-col overflow-y-auto custom-scrollbar z-[150] transition-transform duration-300 lg:translate-x-0"
    x-bind:class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'"
  >
    <%!-- User header --%>
    <div class="px-[22px] py-7 border-b border-[rgba(255,255,255,0.06)] flex items-center gap-3.5">
      <div class="w-12 h-12 rounded-full bg-t66-card border-2 border-[rgba(255,77,0,0.3)] flex items-center justify-center font-display text-[1.2rem] tracking-[2px] text-t66-text-muted flex-shrink-0">
        {String.first(@current_user.name || @current_user.user_name || "U") |> String.upcase()}
      </div>
      <div class="min-w-0">
        <div class="font-bold text-[0.95rem] text-t66-text truncate">
          {@current_user.name || @current_user.user_name}
        </div>
        <div class="text-t66-text-muted text-[0.8rem]">@{@current_user.user_name}</div>
      </div>
    </div>

    <%!-- Navigation --%>
    <nav class="flex-1 px-3 py-4">
      <%!-- Main --%>
      <div class="text-[0.6rem] uppercase tracking-[3px] text-t66-text-muted font-bold px-3 pt-4 pb-2">
        Main
      </div>
      <.sidebar_link href="/feed" label="Feed" icon="hero-rss" />
      <.sidebar_link href="/my-challenges" label="My Challenges" icon="hero-fire" />
      <.sidebar_link href="/messages" label="Messages" icon="hero-chat-bubble-left-right" />

      <%!-- Social --%>
      <div class="text-[0.6rem] uppercase tracking-[3px] text-t66-text-muted font-bold px-3 pt-4 pb-2">
        Social
      </div>
      <.sidebar_link href="/connections" label="Connections" icon="hero-user-group" />

      <%!-- Account --%>
      <div class="text-[0.6rem] uppercase tracking-[3px] text-t66-text-muted font-bold px-3 pt-4 pb-2">
        Account
      </div>
      <.sidebar_link
        href={"/people/#{@current_user.user_name}"}
        label="Profile"
        icon="hero-user-circle"
      />
      <.sidebar_link href="/users/settings" label="Settings" icon="hero-cog-6-tooth" />

      <%!-- Admin --%>
      <%= if HeadsUpWeb.Helpers.RoleHelper.is_admin?(@current_user) do %>
        <div class="text-[0.6rem] uppercase tracking-[3px] text-t66-text-muted font-bold px-3 pt-4 pb-2">
          Admin
        </div>
        <.sidebar_link
          href="/admin/challenge-categories"
          label="Challenge Categories"
          icon="hero-rectangle-group"
        />
      <% end %>
    </nav>

    <%!-- Footer: Log Out --%>
    <div class="px-3 py-4 border-t border-[rgba(255,255,255,0.06)]">
      <form method="post" action="/users/log_out" class="m-0">
        <input type="hidden" name="_method" value="delete" />
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <button
          type="submit"
          class="relative flex items-center gap-3 px-3.5 py-[11px] rounded-[10px] text-[0.88rem] text-red-400 font-medium w-full transition-all hover:bg-[rgba(239,68,68,0.12)]"
        >
          <.icon name="hero-arrow-right-on-rectangle" class="w-5 h-5 flex-shrink-0" />
          <span>Log Out</span>
        </button>
      </form>
    </div>
  </aside>

  <%!-- Main content --%>
  <main class="pt-16 lg:ml-[260px] min-h-screen bg-t66-bg">
    <div class="max-w-[900px] px-5 sm:px-10 py-10">
      <.flash_group flash={@flash} />
      {@inner_content}
    </div>
  </main>
</div>
